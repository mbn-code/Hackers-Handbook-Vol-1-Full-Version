---
// SidebarToggle.astro - refactored to Astro + minimal JS
---

<button
  type="button"
  aria-pressed="false"
  id="menu-toggle"
  onClick="(() => {
    const body = document.body;
    const pressed = this.getAttribute('aria-pressed') === 'true';
    this.setAttribute('aria-pressed', pressed ? 'false' : 'true');
    body.classList.toggle('mobile-sidebar-toggle', !pressed);
  }).call(this)"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="1em"
    height="1em"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"
    />
  </svg>
  <span class="sr-only">Toggle sidebar</span>
</button>
